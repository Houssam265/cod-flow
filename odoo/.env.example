# ==============================================================================
# COD-Flow - Configuration d'environnement (.env.example)
# Valeurs factices de démonstration - Copiez vers .env et adaptez
# ==============================================================================

# --- Base de données PostgreSQL (Docker) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_secure_password_change_me
POSTGRES_DB=postgres

# --- Port et Connexion Odoo 18 ---
ODOO_PORT=8269
ODOO_URL=http://localhost:8269
ODOO_DB=codflow_db
ODOO_USER=admin@codflow.ma
ODOO_PASSWORD=admin_api_key_or_password_factice

# --- Webhook Make.com (scénario unique avec routeur) ---
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/votre_webhook_telegram_unique

# --- Telegram Bot & Supervision ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_factice
TELEGRAM_ADMIN_CHAT_ID=987654321

# --- Google Gemini API (offre gratuite) ---
GEMINI_API_KEY=AIzaSy_votre_cle_gemini_factice

# --- Tunnel ngrok (exposition d'Odoo vers Make.com) ---
# Token : dashboard.ngrok.com → Your Authtoken
NGROK_AUTHTOKEN=votre_authtoken_ngrok_factice
# Domaine fixe gratuit : dashboard.ngrok.com → Domains (sans https://)
NGROK_DOMAIN=votre-nom.ngrok-free.dev
