# ==============================================================================
# COD-Flow - Configuration d'environnement (.env.example)
# Copiez ce fichier vers .env et renseignez vos informations réelles
# ==============================================================================

# --- Base de données PostgreSQL (Docker) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_codflow_password_change_me
POSTGRES_DB=postgres

# --- Connexion Odoo 18 XML-RPC ---
ODOO_URL=http://localhost:8069
ODOO_DB=codflow_db
ODOO_USER=admin@codflow.ma
# Dans Odoo 18, utilisez un mot de passe ou une clé d'API utilisateur (Profil > Clés d'API)
ODOO_PASSWORD=admin_api_key_or_password

# --- Webhooks Make.com ---
MAKE_WEBHOOK_URL_S1=https://hook.eu2.make.com/votre_token_webhook_s1
MAKE_WEBHOOK_URL_S2=https://hook.eu2.make.com/votre_token_webhook_s2
MAKE_WEBHOOK_URL_S3=https://hook.eu2.make.com/votre_token_webhook_s3

# --- Canaux de communication ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_exemple
TELEGRAM_ADMIN_CHAT_ID=987654321
TWILIO_ACCOUNT_SID=AC_votre_account_sid_si_whatsapp
TWILIO_AUTH_TOKEN=votre_auth_token_si_whatsapp

# --- Transporteur (Google Sheet) ---
GOOGLE_SHEET_ID=1A2B3C4D5E6F7G8H9I0J1K2L3M4N5O6P_exemple
GOOGLE_SHEET_TAB_NAME=Expeditions_COD

# Gemini key
GEMINI_API_KEY=ta_cle_gemini

# --- Tunnel ngrok (expose Odoo à Make.com) ---
# Token : dashboard.ngrok.com → Your Authtoken
NGROK_AUTHTOKEN=votre_authtoken_ngrok
# Domaine fixe gratuit : dashboard.ngrok.com → Domains (sans https://)
NGROK_DOMAIN=votre-nom.ngrok-free.dev